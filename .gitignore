# Lexi: pnpm workspace (TypeScript), Tauri 2 (Rust), Android.
# Tauri also keeps its own .gitignore files under each src-tauri/ and gen/android/.

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
target/
*.tsbuildinfo
coverage/

# Tauri generated files
**/src-tauri/gen/schemas/

# Android build output and signing material
.gradle/
**/gen/android/**/build/
local.properties
*.apk
*.aab
*.jks
*.keystore
keystore.properties

# Secrets and local config (the repo is public)
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
.vs/
.DS_Store
Thumbs.db
Desktop.ini
